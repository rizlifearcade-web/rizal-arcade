VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only Vercel Function variables. Never prefix the service-role key with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: use a separate long random value for semester archive receipts.
# If omitted, the server derives a signing key from SUPABASE_SERVICE_ROLE_KEY.
SEMESTER_ARCHIVE_SIGNING_SECRET=replace-with-a-long-random-secret
